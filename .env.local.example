# --- Jetson connection (companion deploy + adb) ---
# Password for the 'nano-counter' user on the Jetson. NEVER commit the real value.
JETSON_PASSWORD=changeme

# --- Jetson IPs ---
# Home WiFi (static). The Jetson can also run its own hotspot (192.168.100.1);
# when in hotspot mode the home WiFi IP is unreachable.
JETSON_WIFI_IP=192.168.0.180
JETSON_HOTSPOT_IP=192.168.100.1

# --- Companion ---
COMPANION_PORT=8090
# Host path to the shared files dir (hostPath /files in the countingapp pod).
FILES_PATH=/data/orin/files

# --- GitHub (for gh CLI / pushes from a worktree) ---
# Personal access token. NEVER commit the real value.
GITHUB_TOKEN=changeme